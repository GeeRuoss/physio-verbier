---
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-500.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/cormorant-garamond/latin-500-italic.css";
import "../styles/style.css";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import FindUs from "../components/FindUs.astro";
import Arrow from "../components/Arrow.astro";
import {
  asset,
  href,
  ui,
  maps,
  whatsapp,
  type Lang,
  type Page,
} from "../data/site";
const {
  lang = "fr",
  page = "home",
  title,
  description,
} = Astro.props as {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
};
const descriptionsForClinic = (lang: Lang) => lang === "fr"
  ? "Cabinet de physiothérapie, massages et coaching sportif à Verbier."
  : "Physiotherapy, massage and personal training clinic in Verbier.";
const t = ui[lang];
const pages: Page[] = ["home", "team", "services", "pricing", "location"];
const canonical = new URL(href(lang, page), Astro.site);
const preview = import.meta.env.PUBLIC_PREVIEW !== "false";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={preview ? "noindex, nofollow" : "index, follow"}
    />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="fr"
      href={new URL(href("fr", page), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(href("en", page), Astro.site)}
    />
    <link rel="alternate" hreflang="x-default" href={new URL(href("fr", page), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(asset("images/og-image.jpg"), Astro.site)}
    />
    <meta property="og:locale" content={lang === "fr" ? "fr_CH" : "en_GB"} />
    {!preview && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "MedicalClinic",
          "@id": "https://physio-verbier.com/#clinic",
          name: "PhysioVerbier",
          description: descriptionsForClinic(lang),
          image: "https://physio-verbier.com/images/photo-02-1280.webp",
          logo: "https://physio-verbier.com/images/logo.png",
          hasMap: maps,
          sameAs: ["https://www.instagram.com/physioverbier/", "https://www.facebook.com/physioverbier/"],
          openingHoursSpecification: [{
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "08:30", closes: "18:30",
          }],
          url: "https://physio-verbier.com",
          telephone: "+41275650660",
          email: "info@physio-verbier.com",
          address: {
            "@type": "PostalAddress",
            streetAddress: "Route de Verbier Station 74",
            postalCode: "1936",
            addressLocality: "Verbier",
            addressCountry: "CH",
          },
        })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>

    <!-- === NAVIGATION PARTAGÉE === -->
    <header class="site-header">
      <a
        href={href(lang, "home")}
        class="brand"
        aria-label={`PhysioVerbier · ${t.nav[0]}`}
      >
        <img
          src={asset("images/logo.png")}
          alt="PhysioVerbier"
          width="250"
          height="100"
        />
      </a>
      <nav
        class="desktop-nav"
        aria-label={lang === "fr" ? "Navigation principale" : "Main navigation"}
      >
        {pages.map((p, i) => (
          <a
            href={href(lang, p)}
            aria-current={page === p ? "page" : undefined}
          >
            {t.nav[i]}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <a
          class="language"
          href={href(lang === "fr" ? "en" : "fr", page)}
          lang={lang === "fr" ? "en" : "fr"}
          aria-label={
            lang === "fr" ? "Switch to English" : "Passer en français"
          }
        >
          {lang === "fr" ? "EN" : "FR"}
        </a>
        <a
          class="button button--small header-book"
          href={href(lang, "contact")}
        >
          {t.book}
          <Arrow diagonal />
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-navigation"
          data-open={t.menu}
          data-close={t.close}
        >
          <span>{t.menu}</span>
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
      </div>
      <nav
        id="mobile-navigation"
        class="mobile-nav"
        hidden
        aria-label={lang === "fr" ? "Navigation mobile" : "Mobile navigation"}
      >
        {pages.map((p, i) => (
          <a
            href={href(lang, p)}
            aria-current={page === p ? "page" : undefined}
          >
            <span class="nav-index">0{i + 1}</span>
            {t.nav[i]}
            <Arrow />
          </a>
        ))}
        <a class="mobile-contact" href={href(lang, "contact")}>
          {t.book}
          <Arrow diagonal />
        </a>
      </nav>
    </header>
    <noscript>
      <nav
        class="nojs-nav container"
        aria-label={lang === "fr" ? "Navigation" : "Navigation"}
      >
        {pages.map((p, i) => (
          <a href={href(lang, p)}>{t.nav[i]}</a>
        ))}
        <a href={href(lang, "contact")}>{t.book}</a>
      </nav>
    </noscript>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <!-- === INVITATION ET PIED DE PAGE === -->
    {page !== "contact" && page !== "privacy" && (
      <section class="closing-cta">
        <div class="container">
          <h2>
            {t.together}
            <br />
            <em>{t.mountains}</em>
          </h2>
          <a class="button button--cream" href={href(lang, "contact")}>
            {t.book}
            <Arrow diagonal />
          </a>
        </div>
      </section>
    )}
    {page !== "location" && page !== "privacy" && <FindUs lang={lang} />}
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href={href(lang, "home")}>
            <img
              src={asset("images/photo-06.svg")}
              alt="PhysioVerbier"
              width="250"
              height="120"
            />
          </a>
          <p>{t.disciplines.join(" · ")}</p>
          <div class="social-links">
            <a href={maps} target="_blank" rel="noopener noreferrer">
              {lang === "fr" ? "Avis Google" : "Google reviews"}
              <Arrow diagonal />
            </a>
            <a
              href="https://www.instagram.com/physioverbier/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Instagram
              <Arrow diagonal />
            </a>
            <a
              href="https://www.facebook.com/physioverbier/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Facebook
              <Arrow diagonal />
            </a>
          </div>
        </div>
        <div>
          <h2>{t.address}</h2>
          <a
            class="address-link"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.route}
            <br />
            {t.town}
            <Arrow diagonal />
          </a>
          <a href="tel:+41275650660">+41 (0)27 565 06 60</a>
          <a href="mailto:info@physio-verbier.com">info@physio-verbier.com</a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer">
            WhatsApp · +41 (0)76 236 09 88
          </a>
        </div>
        <div>
          <h2>{t.appointments}</h2>
          <p>{t.appointmentHours}</p>
          <h2>{t.reception}</h2>
          <p>
            {t.phoneHours}
            <br />
            {t.phoneHours2}
          </p>
          <p>{t.daily}</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} PhysioVerbier
          {preview ? ` · ${t.previewMore}` : ""}
        </span>
        <a href={href(lang, "privacy")}>
          {t.legal} & {t.privacy.toLowerCase()}
        </a>
        <span>
          {" "}
          <a
            href="https://www.ruosscommunication.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ruoss!
          </a>
        </span>
      </div>
    </footer>
    <aside class="wa-widget" aria-label={lang === "fr" ? "Rendez-vous WhatsApp" : "WhatsApp appointments"}>
      <div class="wa-invite" hidden>
        <button class="wa-close" type="button" aria-label={lang === "fr" ? "Fermer l’invitation" : "Close invitation"}>×</button>
        <p>{lang === "fr" ? "Prenez rendez-vous sur WhatsApp." : "Book your appointment on WhatsApp."}</p>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer">{lang === "fr" ? "Écrivez-nous" : "Message us"} ↗</a>
      </div>
      <a class="wa-float" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label={lang === "fr" ? "Prendre rendez-vous sur WhatsApp" : "Book on WhatsApp"}><WhatsAppIcon /></a>
    </aside>
    <script>
      const invite = document.querySelector<HTMLElement>(".wa-invite");
      const seenKey = "pv-whatsapp-seen";
      let seen = false;
      try { seen = sessionStorage.getItem(seenKey) === "1"; } catch {}
      const remember = () => { seen = true; try { sessionStorage.setItem(seenKey, "1"); } catch {} };
      const dismiss = () => { if(invite) invite.hidden = true; remember(); };
      document.querySelector(".wa-close")?.addEventListener("click", dismiss);
      document.querySelectorAll(".wa-widget a").forEach(a => a.addEventListener("click", dismiss));
      document.addEventListener("keydown", e => { if(e.key === "Escape" && invite && !invite.hidden) dismiss(); });
      const offer = () => {
        if(seen || !invite) return;
        if(document.hidden || document.querySelector('.menu-toggle[aria-expanded="true"]') || document.activeElement?.matches('input, textarea, select, [contenteditable="true"]')) { window.setTimeout(offer, 1000); return; }
        invite.hidden = false; remember();
      };
      window.setTimeout(offer, 5000);
      document.querySelectorAll<HTMLButtonElement>(".share-location").forEach(button => button.addEventListener("click", async () => {
        const url = new URL(button.dataset.url || "", location.origin).href;
        try { await navigator.clipboard.writeText(url); button.textContent = button.dataset.copied || "Lien copié"; }
        catch { const status = button.parentElement?.querySelector<HTMLElement>(".share-status"); if(status) status.textContent = url; }
      }));

      // Menu mobile : fermeture clavier, clic extérieur et passage au grand écran.
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-navigation");
      const setMenu = (open: boolean) => {
        if (!toggle || !menu) return;
        toggle.setAttribute("aria-expanded", String(open));
        menu.hidden = !open;
        toggle.querySelector("span")!.textContent =
          (open ? toggle.dataset.close : toggle.dataset.open) || "Menu";
      };
      toggle?.addEventListener("click", () =>
        setMenu(toggle.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          toggle.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (!(e.target as Element).closest(".site-header")) setMenu(false);
      });
      window
        .matchMedia("(min-width: 1100px)")
        .addEventListener("change", () => setMenu(false));
      // Le contenu reste visible sans JavaScript et sans animation.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          el.classList.add("will-reveal");
          observer.observe(el);
        });
      }
      // Prototype uniquement : aucune requête, aucun stockage, aucune confirmation trompeuse.
      const form = document.querySelector<HTMLFormElement>("[data-demo-form]");
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        const status = document.querySelector<HTMLElement>("#form-status");
        if (status) {
          status.hidden = false;
          status.focus();
        }
        form.reset();
      });
    </script>
  </body>
</html>
