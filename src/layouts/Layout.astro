---
import { getImage } from "astro:assets";
import { heroImage, heroAlt, heroPosition } from "../data/media";
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-500.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/montserrat/latin-400.css";
import "@fontsource/montserrat/latin-500.css";
import "../styles/style.css";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import FindUs from "../components/FindUs.astro";
import ContactIcon from "../components/ContactIcon.astro";
import Arrow from "../components/Arrow.astro";
import {
  asset,
  href,
  ui,
  maps,
  whatsapp,
  type Lang,
  type Page,
} from "../data/site";
const {
  lang = "fr",
  page = "home",
  title,
  description,
} = Astro.props as {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
};
const descriptionsForClinic = (lang: Lang) => lang === "fr"
  ? "Cabinet de physiothérapie, massages et coaching sportif à Verbier."
  : "Physiotherapy, massage and personal training clinic in Verbier.";
const t = ui[lang];
const pages: Page[] = ["home", "team", "services", "pricing", "location"];
const canonical = new URL(href(lang, page), Astro.site);
const socialImage = await getImage({ src: heroImage, width: 1200, height: 630, fit: "cover", position: heroPosition, format: "jpg", quality: 85 });
const socialImageUrl = new URL(socialImage.src, Astro.site);
const preview = import.meta.env.PUBLIC_PREVIEW !== "false";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={preview ? "noindex, nofollow" : "index, follow"}
    />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="fr"
      href={new URL(href("fr", page), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(href("en", page), Astro.site)}
    />
    <link rel="alternate" hreflang="x-default" href={new URL(href("fr", page), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={socialImageUrl}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={heroAlt[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={heroAlt[lang]} />
    <meta property="og:locale" content={lang === "fr" ? "fr_CH" : "en_GB"} />
    {!preview && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "MedicalClinic",
          "@id": "https://physio-verbier.com/#clinic",
          name: "PhysioVerbier",
          description: descriptionsForClinic(lang),
          image: "https://physio-verbier.com/images/photo-02-1280.webp",
          logo: "https://physio-verbier.com/images/logo.png",
          hasMap: maps,
          sameAs: ["https://www.instagram.com/physioverbier/", "https://www.facebook.com/physioverbier/"],
          openingHoursSpecification: [{
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "08:30", closes: "18:00",
          }],
          url: "https://physio-verbier.com",
          telephone: "+41275650660",
          email: "info@physio-verbier.com",
          address: {
            "@type": "PostalAddress",
            streetAddress: "Route de Verbier Station 74",
            postalCode: "1936",
            addressLocality: "Verbier",
            addressCountry: "CH",
          },
        })}
      ></script>
    )}
  </head>
  <body data-page={page} id="top">
    <a class="skip-link" href="#main">
      {t.skip}
    </a>

    <!-- === NAVIGATION PARTAGÉE === -->
    <header class="site-header">
      <a
        href={href(lang, "home")}
        class="brand"
        aria-label={`PhysioVerbier · ${t.nav[0]}`}
      >
        <img
          src={asset("images/logo.png")}
          alt="PhysioVerbier"
          width="250"
          height="100"
        />
      </a>
      <nav
        class="desktop-nav"
        aria-label={lang === "fr" ? "Navigation principale" : "Main navigation"}
      >
        {pages.map((p, i) => (
          <a
            href={href(lang, p)}
            aria-current={page === p ? "page" : undefined}
          >
            {t.nav[i]}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <a
          class="language"
          href={href(lang === "fr" ? "en" : "fr", page)}
          lang={lang === "fr" ? "en" : "fr"}
          aria-label={
            lang === "fr" ? "Switch to English" : "Passer en français"
          }
        >
          {lang === "fr" ? "EN" : "FR"}
        </a>
        <a
          class="button button--small header-book"
          href={href(lang, "contact")}
        >
          {t.book}
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-navigation"
          aria-label={t.menu}
          data-open={t.menu}
          data-close={t.close}
        >
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
      </div>
      <nav
        id="mobile-navigation"
        class="mobile-nav"
        hidden
        aria-label={lang === "fr" ? "Navigation mobile" : "Mobile navigation"}
      >
        {pages.map((p, i) => (
          <a
            href={href(lang, p)}
            aria-current={page === p ? "page" : undefined}
          >
            {t.nav[i]}
          </a>
        ))}
        <a class="mobile-contact" href={href(lang, "contact")}>
          {t.book}
        </a>
      </nav>
    </header>
    <noscript>
      <nav
        class="nojs-nav container"
        aria-label={lang === "fr" ? "Navigation" : "Navigation"}
      >
        {pages.map((p, i) => (
          <a href={href(lang, p)}>{t.nav[i]}</a>
        ))}
        <a href={href(lang, "contact")}>{t.book}</a>
      </nav>
    </noscript>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <!-- === INVITATION ET PIED DE PAGE === -->
    {page !== "location" && page !== "privacy" && page !== "contact" && <FindUs lang={lang} />}
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href={href(lang, "home")}>
            <img
              src={asset("images/photo-06.svg")}
              alt="PhysioVerbier"
              width="250"
              height="120"
            />
          </a>
          <p>{t.disciplines.join(" · ")}</p>
          <div class="social-links">
            <a href={maps} target="_blank" rel="noopener noreferrer">
              {lang === "fr" ? "Avis Google" : "Google reviews"}

            </a>
            <a
              href="https://www.instagram.com/physioverbier/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <ContactIcon name="instagram" /> Instagram

            </a>
            <a
              href="https://www.facebook.com/physioverbier/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <ContactIcon name="facebook" /> Facebook

            </a>
          </div>
        </div>
        <div>
          <h2><ContactIcon name="pin" />{t.address}</h2>
          <a
            class="address-link"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.route}
            <br />
            {t.town}

          </a>
          <a class="icon-link" href="tel:+41275650660"><ContactIcon name="phone" /><span>+41 (0)27 565 06 60</span></a>
          <a class="icon-link" href="mailto:info@physio-verbier.com"><ContactIcon name="mail" /><span>info@physio-verbier.com</span></a>
          <a class="icon-link" href={whatsapp} target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon />
            <span>WhatsApp +41 (0)76 236 09 88</span>
          </a>
        </div>
        <div class="footer-hours">
          <h2><ContactIcon name="clock" />{t.appointments}</h2>
          <p>{t.appointmentHours}</p>
          <p>{t.openYear}</p>
          <h2><ContactIcon name="phone" />{t.reception}</h2>
          <p>
            {t.phoneHours}
            <br />
            {t.phoneHours2}
          </p>
          <p>{t.daily}</p>
        </div>
      </div>
      <div class="container footer-tools"><a class="back-to-top" href="#top"><Arrow /><span>{lang === "fr" ? "Revenir en haut" : "Back to top"}</span></a></div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} PhysioVerbier
          {preview ? ` · ${t.previewMore}` : ""}
        </span>
        <a href={href(lang, "privacy")}>
          {t.legal} & {t.privacy.toLowerCase()}
        </a>
        <span>
          {" "}
          <a
            href="https://www.ruosscommunication.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ruoss!
          </a>
        </span>
      </div>
    </footer>
    <aside class="wa-widget" aria-label={lang === "fr" ? "Rendez-vous WhatsApp" : "WhatsApp appointments"}>
      <a class="wa-float" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label={lang === "fr" ? "Contacter le cabinet sur WhatsApp" : "Contact the clinic on WhatsApp"}><WhatsAppIcon /></a>
    </aside>
    <script>
      document.querySelector<HTMLAnchorElement>(".back-to-top")?.addEventListener("click", event => {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
        document.querySelector<HTMLAnchorElement>(".brand")?.focus({ preventScroll: true });
      });
      document.querySelectorAll<HTMLButtonElement>(".share-location").forEach(button => button.addEventListener("click", async () => {
        const url = new URL(button.dataset.url || "", location.origin).href;
        try { await navigator.clipboard.writeText(url); button.textContent = button.dataset.copied || "Lien copié"; }
        catch { const status = button.parentElement?.querySelector<HTMLElement>(".share-status"); if(status) status.textContent = url; }
      }));

      // Animation progressive des accordéons ; le HTML natif reste utilisable sans JS.
      document.querySelectorAll<HTMLDetailsElement>(".detail-row").forEach(details => {
        const summary = details.querySelector("summary");
        let animation: Animation | null = null;
        let expanded = details.open;
        summary?.addEventListener("click", event => {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          event.preventDefault();
          const start = details.getBoundingClientRect().height;
          expanded = animation ? !expanded : !details.open;
          animation?.cancel();
          details.open = true;
          details.style.height = "auto";
          const end = expanded ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height + 1;
          details.dataset.expanded = String(expanded);
          details.style.overflow = "hidden";
          animation = details.animate({ height: [`${start}px`, `${end}px`] }, { duration: 300, easing: "cubic-bezier(.22,1,.36,1)" });
          animation.onfinish = () => {
            details.open = expanded;
            details.style.height = "";
            details.style.overflow = "";
            delete details.dataset.expanded;
            animation = null;
          };
        });
      });
      // Menu mobile : fermeture clavier, clic extérieur et passage au grand écran.
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-navigation");
      const setMenu = (open: boolean) => {
        if (!toggle || !menu) return;
        toggle.setAttribute("aria-expanded", String(open));
        menu.hidden = !open;
        toggle.setAttribute("aria-label", (open ? toggle.dataset.close : toggle.dataset.open) || "Menu");
      };
      toggle?.addEventListener("click", () =>
        setMenu(toggle.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          toggle.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (!(e.target as Element).closest(".site-header")) setMenu(false);
      });
      window
        .matchMedia("(min-width: 1100px)")
        .addEventListener("change", () => setMenu(false));
      // Le contenu reste visible sans JavaScript et sans animation.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          el.classList.add("will-reveal");
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
