---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import Photo from "../components/Photo.astro";
import TeamCards from "../components/TeamCards.astro";
import content from "../data/content.json";
import {
  routes,
  href,
  ui,
  maps,
  whatsapp,
  type Lang,
  type Page,
} from "../data/site";
export function getStaticPaths() {
  return (["fr", "en"] as Lang[]).flatMap((lang) =>
    Object.entries(routes[lang]).map(([page, path]) => ({
      params: { route: path.replace(/\/$/, "") || undefined },
      props: { lang, page },
    })),
  );
}
const { lang, page } = Astro.props as { lang: Lang; page: Page };
const t = ui[lang],
  c = content[lang];
const titles = {
  home:
    lang === "fr"
      ? "Physiothérapie, sport et bien-être à Verbier"
      : "Physiotherapy, sport and well-being in Verbier",
  team: t.meet,
  services: t.allServices,
  pricing:
    lang === "fr" ? "Tarifs et première visite" : "Prices and your first visit",
  location: t.locationTitle,
  contact: t.book,
  privacy: t.privacy,
};
const description =
  page === "home"
    ? t.intro
    : page === "team"
      ? t.teamIntro
      : page === "pricing"
        ? t.pricingIntro
        : page === "location"
          ? t.locationIntro
          : page === "contact"
            ? t.contactIntro
            : lang === "fr"
              ? "Découvrez PhysioVerbier : physiothérapie, massages et coaching sportif au cœur de Verbier."
              : "Discover PhysioVerbier: physiotherapy, massage and personal training in the heart of Verbier.";
const names = ["Piero", "Hannah", "Sybille"];
const ids = ["physiotherapie", "massages", "coaching"];
const plain = (s: string) =>
  s
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
---

<Layout
  lang={lang}
  page={page}
  title={`${titles[page]} | PhysioVerbier`}
  description={description}
>
  {page === "home" && (
    <>
      <!-- === ACCUEIL : MONTAGNE ET MOUVEMENT === -->
      <section class="home-intro container">
        <div class="hero-topline">
          <p class="eyebrow">
            <span class="status-dot"></span>
            {t.local}
          </p>
          <span class="small-label">Verbier · Val de Bagnes</span>
        </div>
        <div class="hero-heading">
          <h1>
            {t.hero}
            <br />
            <em>{t.heroEm}</em>
          </h1>
          <div class="hero-aside">
            <p>{t.intro}</p>
            <a class="text-link" href={href(lang, "contact")}>
              {t.book}
              <Arrow diagonal />
            </a>
          </div>
        </div>
      </section>
      <div class="hero-photo-wrap">
        <Photo
          class="hero-photo"
          id={1}
          eager
          alt={
            lang === "fr"
              ? "Snowboard dans les montagnes de Verbier"
              : "Snowboarding in the mountains of Verbier"
          }
          sizes="100vw"
        />
        <div class="hero-photo__caption">
          <span>Verbier, Valais</span>
          <a href="#bienvenue" aria-label={t.discover}>
            <Arrow class="arrow-down" />
          </a>
        </div>
        <div class="hero-photo__word">
          {lang === "fr" ? "Le mouvement, c’est la vie." : "Movement is life."}
        </div>
      </div>
      <div class="discipline-band">
        {t.disciplines.map((word, i) => (
          <>
            <span>{word}</span>
            {i < 3 && (
              <svg
                class="asterisk"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
            )}
          </>
        ))}
      </div>
      <section
        id="bienvenue"
        class="section container welcome-section"
        data-reveal
      >
        <p class="eyebrow">01 / {t.welcome}</p>
        <div class="editorial-grid">
          <h2>
            {t.careTitle}
            <br />
            <em>{t.careEm}</em>
          </h2>
          <div class="prose welcome-copy" set:html={c.home[2]} />
        </div>
        <div class="care-grid">
          <div class="care-photo">
            <Photo
              id={2}
              alt={
                lang === "fr"
                  ? "Séance de soin personnalisé chez PhysioVerbier"
                  : "Personalised treatment at PhysioVerbier"
              }
            />
            <span class="photo-caption">
              {lang === "fr"
                ? "L’écoute. Le soin. Le mouvement."
                : "Listen. Care. Move."}
            </span>
          </div>
          <div class="care-copy prose">
            <span class="large-index" aria-hidden="true">
              01
            </span>
            <div set:html={c.home[3]} />
            <a class="text-link" href={href(lang, "services")}>
              {t.discover}
              <Arrow diagonal />
            </a>
          </div>
        </div>
      </section>
      <section class="section services-preview">
        <div class="container">
          <div class="section-heading" data-reveal>
            <div>
              <p class="eyebrow">02 / {t.nav[2]}</p>
              <h2>
                {t.servicesTitle}
                <br />
                <em>{t.servicesEm}</em>
              </h2>
            </div>
            <a class="text-link" href={href(lang, "services")}>
              {t.allServices}
              <Arrow diagonal />
            </a>
          </div>
          <div class="service-links">
            {t.serviceNames.map((name, i) => (
              <a
                class="service-link"
                href={`${href(lang, "services")}#${ids[i]}`}
                data-reveal
              >
                <span class="service-number">0{i + 1}</span>
                <Photo id={[10, 13, 14][i]} alt="" sizes="200px" />
                <div>
                  <h3>{name}</h3>
                  <p>{t.serviceDesc[i]}</p>
                </div>
                <span class="round-arrow">
                  <Arrow diagonal />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="section container">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">03 / {t.nav[1]}</p>
            <h2>
              {t.teamTitle}
              <br />
              <em>{t.teamEm}</em>
            </h2>
          </div>
          <a class="text-link" href={href(lang, "team")}>
            {t.meet}
            <Arrow diagonal />
          </a>
        </div>
        <TeamCards lang={lang} />
        <div class="team-context prose" set:html={c.home[4]} />
      </section>
      <section class="approach-section">
        <div class="approach-photo">
          <Photo
            id={4}
            alt={
              lang === "fr"
                ? "Le lac de Louvie et les sommets du Val de Bagnes"
                : "Lac de Louvie and the peaks of Val de Bagnes"
            }
          />
        </div>
        <div class="approach-copy" data-reveal>
          <p class="eyebrow">04 / {t.approach}</p>
          <h2>
            {t.approachTitle}
            <br />
            <em>{t.approachEm}</em>
          </h2>
          <div class="prose" set:html={c.home[5]} />
        </div>
      </section>
      <section class="section container promise-section" data-reveal>
        <p class="eyebrow">PhysioVerbier</p>
        <p class="statement">{plain(c.home[6])}</p>
        <a class="text-link" href={href(lang, "location")}>
          {t.locationTitle}
          <Arrow diagonal />
        </a>
      </section>
      <section class="reviews-strip">
        <div class="container">
          <div>
            <p class="eyebrow">Google</p>
            <h2>{t.reviews}</h2>
            <p>{t.reviewsText}</p>
          </div>
          <a
            class="text-link"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.reviewsLink}
            <Arrow diagonal />
          </a>
        </div>
      </section>
    </>
  )}
  {page === "team" && (
    <>
      <section class="page-intro container">
        <p class="eyebrow">{t.nav[1]} / PhysioVerbier</p>
        <h1>
          {t.teamTitle}
          <br />
          <em>{t.teamEm}</em>
        </h1>
        <p class="lead">{t.teamIntro}</p>
      </section>
      <div class="wide-photo container">
        <Photo
          id={15}
          eager
          alt={
            lang === "fr"
              ? "L’équipe devant le cabinet PhysioVerbier"
              : "The team outside the PhysioVerbier clinic"
          }
          sizes="100vw"
        />
      </div>
      <nav
        class="anchor-nav container"
        aria-label={lang === "fr" ? "Les thérapeutes" : "Our therapists"}
      >
        {names.map((name) => (
          <a href={`#${name.toLowerCase()}`}>
            {name}
            <Arrow class="arrow-down" />
          </a>
        ))}
      </nav>
      <div class="container team-profiles">
        {names.map((name, i) => (
          <section id={name.toLowerCase()} class="profile">
            <div class="profile-photo">
              <Photo id={16 + i} alt={name} />
              <span class="photo-caption">PhysioVerbier / {name}</span>
            </div>
            <div class="profile-copy">
              <p class="eyebrow">
                0{i + 1} /{" "}
                {lang === "fr" ? "Votre thérapeute" : "Your therapist"}
              </p>
              <h2>{name}</h2>
              <div class="profile-role" set:html={c.team[2 + i * 3]} />
              <div class="prose biography" set:html={c.team[3 + i * 3]} />
              <a class="text-link" href={href(lang, "contact")}>
                {t.book}
                <Arrow diagonal />
              </a>
            </div>
          </section>
        ))}
      </div>
    </>
  )}
  {page === "services" && (
    <>
      <section class="page-intro container">
        <p class="eyebrow">{t.nav[2]} / PhysioVerbier</p>
        <h1>
          {t.servicesLead}
          <br />
          <em>{t.servicesLeadEm}</em>
        </h1>
        <div class="lead prose" set:html={c.services[1]} />
      </section>
      <nav class="anchor-nav container" aria-label={t.allServices}>
        {t.serviceNames.map((name, i) => (
          <a href={`#${ids[i]}`}>
            {name}
            <Arrow class="arrow-down" />
          </a>
        ))}
      </nav>
      <section class="container section treatment" id="physiotherapie">
        <div class="treatment-heading">
          <p class="eyebrow">01 / {t.serviceNames[0]}</p>
          <h2>{t.serviceNames[0]}</h2>
          <div class="prose" set:html={c.services[3]} />
        </div>
        <Photo
          class="treatment-photo"
          id={12}
          eager
          alt={
            lang === "fr"
              ? "Exercices de rééducation accompagnés par un physiothérapeute"
              : "Guided rehabilitation exercises with a physiotherapist"
          }
        />
        <div class="techniques">
          <h3 class="eyebrow">{t.techniques}</h3>
          {[4, 5, 6, 7].map((index) => (
            <details class="detail-row">
              <summary>
                {plain(c.services[index].split("</p>")[0])}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div
                class="prose"
                set:html={c.services[index].slice(
                  c.services[index].indexOf("</p>") + 4,
                )}
              />
            </details>
          ))}
          <div class="prose treatment-note" set:html={c.services[8]} />
        </div>
      </section>
      <section class="specialties-section section">
        <div class="container">
          <p class="eyebrow">{t.specialized}</p>
          <h2>{t.specializedEm}</h2>
          <div class="specialties-grid">
            {t.specialtyNames.map((name, i) => (
              <article>
                <span class="service-number">0{i + 1}</span>
                <h3>{name}</h3>
                <div class="prose" set:html={c.services[10 + i]} />
              </article>
            ))}
          </div>
        </div>
      </section>
      <section id="massages" class="container section service-feature">
        <Photo
          id={13}
          alt={
            lang === "fr"
              ? "Massage thérapeutique au cabinet"
              : "Therapeutic massage at the clinic"
          }
        />
        <div>
          <p class="eyebrow">02 / {t.serviceNames[1]}</p>
          <h2>{t.serviceNames[1]}</h2>
          <div class="prose" set:html={c.services[17]} />
          <a class="text-link" href={href(lang, "pricing")}>
            {t.nav[3]}
            <Arrow diagonal />
          </a>
        </div>
      </section>
      <section
        id="coaching"
        class="container section service-feature service-feature--reverse"
      >
        <Photo
          id={14}
          alt={
            lang === "fr"
              ? "Entraînement en plein air dans les Alpes"
              : "Outdoor training in the Alps"
          }
        />
        <div>
          <p class="eyebrow">03 / {t.serviceNames[2]}</p>
          <h2>{t.serviceNames[2]}</h2>
          <div class="prose" set:html={c.services[19]} />
          <a class="text-link" href={href(lang, "contact")}>
            {t.book}
            <Arrow diagonal />
          </a>
        </div>
      </section>
    </>
  )}
  {page === "pricing" && (
    <>
      <section class="page-intro container">
        <p class="eyebrow">{t.nav[3]} / PhysioVerbier</p>
        <h1>
          {t.pricingTitle}
          <br />
          <em>{t.pricingEm}</em>
        </h1>
        <p class="lead">{t.pricingIntro}</p>
      </section>
      <section class="container pricing-grid" aria-label={t.privateRates}>
        {t.serviceNames.map((name, i) => (
          <article class="price-card">
            <span class="service-number">0{i + 1}</span>
            <h2>{name}</h2>
            <p class="price-description">
              {i === 0 ? t.insurance : t.serviceDesc[i]}
            </p>
            <dl>
              {(i === 1
                ? [
                    [30, 75],
                    [60, 150],
                    [90, 225],
                  ]
                : i === 2
                  ? [
                      [30, 75],
                      [60, 140],
                    ]
                  : [
                      [30, 75],
                      [60, 150],
                    ]
              ).map(([minutes, price]) => (
                <div>
                  <dt>
                    {minutes} {t.minutes}
                  </dt>
                  <dd>
                    {price}
                    <span> CHF</span>
                  </dd>
                </div>
              ))}
            </dl>
            <a class="text-link" href={href(lang, "contact")}>
              {t.book}
              <Arrow diagonal />
            </a>
          </article>
        ))}
      </section>
      <div class="container insurance-note">
        <p>{t.hannahNote}</p>
      </div>
      <section class="section container practical-grid">
        <div>
          <p class="eyebrow">{t.practical}</p>
          <h2>{t.practicalEm}</h2>
          <Photo
            id={22}
            alt={
              lang === "fr"
                ? "Salle de traitement du cabinet"
                : "Treatment room at the clinic"
            }
          />
        </div>
        <div class="practical-details">
          {[5, 7, 9, 11].map((index, i) => (
            <details class="detail-row" open={i === 0}>
              <summary>
                {plain(c.pricing[index])}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div class="prose" set:html={c.pricing[index + 1]} />
            </details>
          ))}
        </div>
      </section>
    </>
  )}
  {page === "location" && (
    <>
      <section class="page-intro container">
        <p class="eyebrow">{t.nav[4]} / PhysioVerbier</p>
        <h1>
          {t.locationTitle}
          <br />
          <em>{t.locationEm}</em>
        </h1>
        <p class="lead">{t.locationIntro}</p>
      </section>
      <section class="location-feature container">
        <Photo
          id={19}
          eager
          alt={
            lang === "fr"
              ? "Vue sur Verbier et les montagnes enneigées"
              : "View of Verbier and its snow-covered mountains"
          }
          sizes="(min-width: 900px) 65vw, 100vw"
        />
        <div class="address-panel">
          <p class="eyebrow">PhysioVerbier</p>
          <h2>
            {t.route}
            <br />
            <em>1936 Verbier</em>
          </h2>
          <a
            class="button button--cream"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.directions}
            <Arrow diagonal />
          </a>
          <span class="small-label">
            {lang === "fr" ? "Ouvre Google Maps" : "Opens Google Maps"}
          </span>
        </div>
      </section>
      <section class="section container location-info">
        <div>
          <p class="eyebrow">{t.openYear}</p>
          <h2>{t.appointments}</h2>
          <p class="lead">{t.appointmentHours}</p>
          <a class="text-link" href={href(lang, "contact")}>
            {t.book}
            <Arrow diagonal />
          </a>
        </div>
        <div>
          <p class="eyebrow">{t.reception}</p>
          <p>
            {t.phoneHours}
            <br />
            {t.phoneHours2}
          </p>
          <p>{t.daily}</p>
          <a class="large-phone" href="tel:+41275650660">
            +41 27 565 06 60
          </a>
        </div>
      </section>
      <div class="container clinic-photos">
        <Photo
          id={3}
          alt={
            lang === "fr"
              ? "L’espace de rééducation du cabinet"
              : "The clinic’s rehabilitation space"
          }
        />
        <Photo
          id={7}
          alt={
            lang === "fr"
              ? "La vitrine PhysioVerbier"
              : "The PhysioVerbier clinic window"
          }
        />
      </div>
    </>
  )}
  {page === "contact" && (
    <>
      <section class="page-intro container">
        <p class="eyebrow">{t.book} / PhysioVerbier</p>
        <h1>
          {t.contactTitle}
          <br />
          <em>{t.contactEm}</em>
        </h1>
        <p class="lead">{t.contactIntro}</p>
      </section>
      <section class="container contact-grid">
        <div class="contact-methods">
          <a class="contact-method" href="tel:+41275650660">
            <span class="eyebrow">01 / {t.call}</span>
            <span>+41 27 565 06 60</span>
            <Arrow diagonal />
          </a>
          <a
            class="contact-method"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="eyebrow">02 / {t.message}</span>
            <span>+41 76 236 09 88</span>
            <Arrow diagonal />
          </a>
          <a class="contact-method" href="mailto:info@physio-verbier.com">
            <span class="eyebrow">03 / {t.write}</span>
            <span>info@physio-verbier.com</span>
            <Arrow diagonal />
          </a>
          <div class="contact-hours">
            <h2>{t.reception}</h2>
            <p>
              {t.phoneHours}
              <br />
              {t.phoneHours2}
            </p>
            <p>{t.daily}</p>
            <a class="text-link" href={href(lang, "location")}>
              {t.nav[4]}
              <Arrow diagonal />
            </a>
          </div>
        </div>
        <div class="form-panel">
          <p class="eyebrow">
            {lang === "fr" ? "Un premier échange" : "A first conversation"}
          </p>
          <h2>{t.formTitle}</h2>
          <p>{t.formIntro}</p>
          <div class="demo-notice" id="demo-notice">
            {t.demo}
          </div>
          <form
            data-demo-form
            method="dialog"
            aria-describedby="demo-notice medical-notice"
          >
            <label for="contact-name">{t.name}</label>
            <input
              id="contact-name"
              type="text"
              autocomplete="off"
              maxlength="100"
              required
            />
            <label for="contact-phone">{t.phone}</label>
            <input
              id="contact-phone"
              type="tel"
              autocomplete="off"
              inputmode="tel"
              maxlength="30"
              minlength="6"
              required
            />
            <label for="contact-email">{t.email}</label>
            <input
              id="contact-email"
              type="email"
              autocomplete="off"
              maxlength="200"
            />
            <p id="medical-notice" class="form-fineprint">
              {t.noMedical}
            </p>
            <button class="button" type="submit">
              {t.submit}
              <Arrow />
            </button>
            <p
              id="form-status"
              class="form-status"
              role="status"
              tabindex="-1"
              hidden
            >
              {t.demoSuccess}
            </p>
            <noscript>
              <p>{t.demo}</p>
            </noscript>
          </form>
          <a class="privacy-link" href={href(lang, "privacy")}>
            {t.privacy}
            <Arrow diagonal />
          </a>
        </div>
      </section>
    </>
  )}
  {page === "privacy" && (
    <>
      <section class="page-intro container">
        <p class="eyebrow">PhysioVerbier</p>
        <h1>
          {t.legal}
          <br />
          <em>& {t.privacy.toLowerCase()}.</em>
        </h1>
      </section>
      <article class="container legal-content prose">
        {lang === "fr" ? (
          <>
            <h2>Cette version de présentation</h2>
            <p>
              Ce site est une première version destinée à présenter le futur
              site de PhysioVerbier. Il est provisoirement hébergé sur GitHub
              Pages. Il ne constitue pas un portail patient et ne permet pas de
              transmettre de demande par formulaire.
            </p>
            <h2>Le cabinet</h2>
            <p>
              PhysioVerbier
              <br />
              Route de Verbier Station 74
              <br />
              1936 Verbier, Suisse
              <br />
              <a href="mailto:info@physio-verbier.com">
                info@physio-verbier.com
              </a>
              <br />
              <a href="tel:+41275650660">+41 27 565 06 60</a>
            </p>
            <h2>Formulaire de démonstration</h2>
            <p>
              Les champs servent uniquement à tester la présentation. Le site
              n’envoie pas leur contenu à un serveur et ne l’enregistre ni dans
              une base de données ni dans le stockage du navigateur. Utilisez
              des informations fictives pour vos essais. Pour une demande
              réelle, appelez le cabinet.
            </p>
            <h2>Hébergement et navigation</h2>
            <p>
              Cette prévisualisation utilise GitHub Pages, et non l’hébergement
              définitif Infomaniak. Le chargement du site communique
              nécessairement des informations techniques à l’hébergeur,
              notamment l’adresse IP. GitHub décrit son traitement dans sa{" "}
              <a
                href="https://docs.github.com/fr/site-policy/privacy-policies/github-general-privacy-statement"
                target="_blank"
                rel="noopener noreferrer"
              >
                déclaration de confidentialité
              </a>
              .
            </p>
            <p>
              Nous n’intégrons ici aucun outil de mesure d’audience, pixel
              publicitaire ou cookie applicatif. Les polices et les images sont
