---
import { Image } from "astro:assets";
import kneeImage from "../assets/soin-genou.jpg";
import teamImage from "../assets/equipe.jpg";
import winterImage from "../assets/verbier-hiver.jpg";
import clinicImage from "../assets/vitrine.jpg";
import rehabilitationImage from "../assets/rehabilitation.webp";
import { heroImage, heroAlt, heroPosition } from "../data/media";
import ContactIcon from "../components/ContactIcon.astro";
import FindUs from "../components/FindUs.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import Booking from "../components/Booking.astro";
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import Photo from "../components/Photo.astro";
import TeamCards from "../components/TeamCards.astro";
import TeamPortrait from "../components/TeamPortrait.astro";
import { teamMembers } from "../data/team";
import content from "../data/content.json";
import {
  routes,
  href,
  ui,
  maps,
  whatsapp,
  type Lang,
  type Page,
} from "../data/site";
export function getStaticPaths() {
  return (["fr", "en"] as Lang[]).flatMap((lang) =>
    Object.entries(routes[lang]).map(([page, path]) => ({
      params: { route: path.replace(/\/$/, "") || undefined },
      props: { lang, page },
    })),
  );
}
const { lang, page } = Astro.props as { lang: Lang; page: Page };
const preview = import.meta.env.PUBLIC_PREVIEW !== "false";
const t = ui[lang],
  c = content[lang];
const titles = lang === "fr" ? {
  home: "Physiothérapie à Verbier · Massages et sport",
  team: "Notre équipe de physiothérapeutes à Verbier",
  services: "Physiothérapie, massages et coaching à Verbier",
  pricing: "Tarifs de physiothérapie et massages à Verbier",
  location: "Cabinet de physiothérapie à Verbier · Accès",
  contact: "Rendez-vous de physiothérapie à Verbier",
  privacy: "Mentions légales et confidentialité",
} : {
  home: "Physiotherapy in Verbier · Massage and sport",
  team: "Our physiotherapy team in Verbier",
  services: "Physiotherapy, massage and coaching in Verbier",
  pricing: "Physiotherapy and massage prices in Verbier",
  location: "Physiotherapy clinic in Verbier · Directions",
  contact: "Book physiotherapy in Verbier",
  privacy: "Legal notice and privacy",
};
const descriptions = lang === "fr" ? {
  home: "Physiothérapie, massages et coaching sportif à Verbier. Soins personnalisés au cabinet, Route de Verbier Station 74. Découvrez l’équipe et prenez rendez-vous.",
  team: "Rencontrez Hannah, Sybille, Julie, Tom et Naomie, l’équipe de PhysioVerbier. Découvrez leurs parcours et leur approche des soins au cabinet de Verbier.",
  services: "Découvrez les soins de PhysioVerbier : physiothérapie, massages et coaching sportif. Un accompagnement adapté à vos besoins au cœur de Verbier.",
  pricing: "Consultez les tarifs de physiothérapie, massages et coaching sportif chez PhysioVerbier et les informations utiles pour préparer votre première visite.",
  location: "Retrouvez PhysioVerbier à la Route de Verbier Station 74, 1936 Verbier. Adresse, itinéraire et horaires du cabinet de physiothérapie.",
  contact: "Prenez rendez-vous chez PhysioVerbier par téléphone, email ou WhatsApp. Retrouvez les coordonnées et horaires de contact du cabinet à Verbier.",
  privacy: "Informations légales, confidentialité et traitement des données sur le site PhysioVerbier.",
} : {
  home: "Physiotherapy, massage and personal training in Verbier. Personalised care at Route de Verbier Station 74. Meet the team and book an appointment.",
  team: "Meet Hannah, Sybille, Julie, Tom and Naomie at PhysioVerbier. Discover their backgrounds and approach to personalised care at our Verbier clinic.",
  services: "Explore physiotherapy, massage and personal training at PhysioVerbier. Personalised care adapted to your needs in the heart of Verbier.",
  pricing: "See physiotherapy, massage and personal training prices at PhysioVerbier and find practical information for your first visit.",
  location: "Find PhysioVerbier at Route de Verbier Station 74, 1936 Verbier. Clinic address, directions and opening hours.",
  contact: "Book an appointment with PhysioVerbier by phone, email or WhatsApp. Find contact details and reception hours for our Verbier clinic.",
  privacy: "Legal information, privacy and data processing on the PhysioVerbier website.",
};
const description = descriptions[page];
const ids = ["physiotherapie", "massages", "coaching"];
const plain = (s: string) =>
  s
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
---

<Layout
  lang={lang}
  page={page}
  title={`${titles[page]} | PhysioVerbier`}
  description={description}
>
  {page === "home" && (
    <>
      <section class="home-intro container">
        <div class="hero-heading">
          <h1>
            {t.hero}
            <br />
            <em>{t.heroEm}</em>
          </h1>

        </div>
      </section>
      <div class="discipline-band" aria-label={lang === "fr" ? "Nos domaines" : "Our disciplines"}>
        {t.disciplines.map(name => <span>{name}</span>)}
      </div>
      <div class="hero-photo-wrap">
        <Image
          class="hero-photo"
          src={heroImage}
          alt={heroAlt[lang]}
          widths={[640, 1280, 1600]}
          style={`object-position: ${heroPosition}`}
          quality={90}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <section id="bienvenue" class="section container welcome-section">
        <div class="care-grid">
          <Image
            src={kneeImage}
            widths={[600, 1214]}
            quality={88}
            loading="lazy"
            sizes="(min-width: 768px) 46vw, 90vw"
            alt={
              lang === "fr"
                ? "Soin du genou chez PhysioVerbier"
                : "Knee treatment at PhysioVerbier"
            }
          />
          <div class="care-copy">
            <h2>
              {t.careTitle}{" "}<em>{t.careEm}</em>
            </h2>
            <div class="prose welcome-text" set:html={c.home[2].slice(c.home[2].indexOf("</p>") + 4)} />
            <a class="text-link" href={href(lang, "services")}>
              {t.discover}
            </a>
          </div>
        </div>
      </section>
      <section class="section services-preview">
        <div class="container">
          <h2>{lang === "fr" ? "Nos soins" : "Our services"}</h2>
          <div class="service-links">
            {t.serviceNames.map((name, i) => (
              <a
                class="service-link"
                href={`${href(lang, "services")}#${ids[i]}`}
              >
                <Photo id={[2, 13, 14][i]} alt="" sizes="200px" />
                <h3>{name}</h3>
                <span class="round-arrow"><Arrow /></span>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="section container">
        <div class="section-heading">
          <h2>{lang === "fr" ? "Notre équipe" : "Our team"}</h2>
        </div>
        <TeamCards lang={lang} />
        <p class="team-commitment">{plain(c.home[6])}</p>
        <div class="team-meet"><a class="text-link" href={href(lang, "team")}>{t.meet}</a></div>
      </section>
      <section class="container section original-approach">
        <details class="detail-row">
          <summary>
            {t.approach}
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="prose">
            {[3, 4, 5].map((i) => (
              <div set:html={c.home[i]} />
            ))}
          </div>
        </details>
      </section>
    </>
  )}
  {page === "team" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.teamTitle}{" "}<em>{t.teamEm}</em>
        </h1>
      </section>
      <div class="wide-photo container">
        <Image
          src={teamImage}
          widths={[640, 1280, 1900]}
          quality={90}
          loading="eager"
          alt={
            lang === "fr"
              ? "L’équipe devant le cabinet PhysioVerbier"
              : "The team outside the PhysioVerbier clinic"
          }
          sizes="100vw"
        />
      </div>
      <nav
        class="anchor-nav container"
        aria-label={lang === "fr" ? "L’équipe" : "Our team"}
      >
        {teamMembers.map(({ name }) => (
          <a href={`#${name.toLowerCase()}`}>
            {name}
          </a>
        ))}
      </nav>
      <div class="container team-profiles">
        {teamMembers.map((member) => (
          <section id={member.name.toLowerCase()} class="profile">
            <div class="profile-photo">
              <TeamPortrait member={member} />
            </div>
            <div class="profile-copy">
              <h2>{member.name}</h2>
              <div class="profile-role" set:html={member.role[lang]} />
              <div class="prose biography" set:html={member.biography[lang]} />
              <a class="text-link" href={href(lang, "contact")}>
                {member.therapist ? t.book : lang === "fr" ? "Contacter le cabinet" : "Contact the clinic"}
              </a>
            </div>
          </section>
        ))}
      </div>

    </>
  )}
  {page === "services" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.servicesLead}
          <br />
          <em>{t.servicesLeadEm}</em>
        </h1>
        <div class="lead prose" set:html={c.services[1]} />
      </section>
      <nav class="anchor-nav container" aria-label={t.allServices}>
        {t.serviceNames.map((name, i) => (
          <a href={`#${ids[i]}`}>
            {name}
          </a>
        ))}
      </nav>
      <section class="container section treatment" id="physiotherapie">
        <div class="treatment-heading">
          <h2>{t.serviceNames[0]}</h2>
          <div class="prose" set:html={c.services[3]} />
        </div>
        <Image
          class="treatment-photo"
          src={rehabilitationImage}
          widths={[640, 1280, 1920]}
          sizes="(min-width: 900px) 46vw, 92vw"
          quality={90}
          loading="eager"
          alt={
            lang === "fr"
              ? "La salle de rééducation et de sport de PhysioVerbier"
              : "The rehabilitation and exercise room at PhysioVerbier"
          }
        />
        <div class="techniques">
          {[4, 5, 6, 7].map((index) => (
            <details class="detail-row">
              <summary>
                {(() => { const label = plain(c.services[index].split("</p>")[0]).toLocaleLowerCase(lang); return label.charAt(0).toLocaleUpperCase(lang) + label.slice(1); })()}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div
                class="prose"
                set:html={c.services[index].slice(
                  c.services[index].indexOf("</p>") + 4,
                )}
              />
            </details>
          ))}
          <div class="prose treatment-note" set:html={c.services[8]} />
          <div class="services-book"><a class="text-link" href={href(lang, "contact")}>{t.book}</a></div>
        </div>
      </section>
      <section class="specialties-section section">
        <div class="container">
          <h2>{t.specializedEm}</h2>
          <div class="specialties-grid">
            {t.specialtyNames.map((name, i) => (
              <article>
                <h3>{name}</h3>
                <div class="prose" set:html={c.services[10 + i]} />
              </article>
            ))}
          </div>
        </div>
      </section>
      <section id="massages" class="container section service-feature">
        <Photo
          id={13}
          alt={
            lang === "fr"
              ? "Massage thérapeutique au cabinet"
              : "Therapeutic massage at the clinic"
          }
        />
        <div>
          <h2>{t.serviceNames[1]}</h2>
          <div class="prose" set:html={c.services[17]} />
          <a class="text-link" href={href(lang, "pricing")}>
            {t.nav[3]}
          </a>
        </div>
      </section>
      <section
        id="coaching"
        class="container section service-feature service-feature--reverse"
      >
        <Photo
          id={14}
          alt={
            lang === "fr"
              ? "Entraînement en plein air dans les Alpes"
              : "Outdoor training in the Alps"
          }
        />
        <div>
          <h2>{t.serviceNames[2]}</h2>
          <div class="prose" set:html={c.services[19]} />
          <a class="text-link" href={href(lang, "pricing")}>
            {t.nav[3]}
          </a>
        </div>
      </section>
    </>
  )}
  {page === "pricing" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.pricingTitle}
          <br />
          <em>{t.pricingEm}</em>
        </h1>
      </section>
      <section class="container pricing-grid" aria-label={t.privateRates}>
        {t.serviceNames.map((name, i) => (
          <article class="price-card">
            <h2>{name}</h2>
            <p class="price-description">
              {i === 0 ? t.insurance : t.serviceDesc[i]}
            </p>
            <dl>
              {(i === 1
                ? [
                    [30, 75],
                    [60, 150],
                    [90, 225],
                  ]
                : i === 2
                  ? [
                      [30, 75],
                      [60, 140],
                    ]
                  : [
                      [30, 75],
                      [60, 150],
                    ]
              ).map(([minutes, price]) => (
                <div>
                  <dt>
                    {minutes} {t.minutes}
                  </dt>
                  <dd>
                    {price}
                    <span> CHF</span>
                  </dd>
                </div>
              ))}
            </dl>
            {i === 0 && <p class="insurance-coverage">{t.insuranceCoverage}</p>}
            <a class="text-link" href={href(lang, "contact")}>
              {t.book}
            </a>
          </article>
        ))}
      </section>
      <div class="container insurance-note">
        <p>{t.hannahNote}</p>
      </div>
      <section class="section container practical-grid">
        <div class="practical-visual">
          <h2>{t.practicalEm}</h2>
          <Photo
            id={22}
            alt={
              lang === "fr"
                ? "Salle de traitement du cabinet"
                : "Treatment room at the clinic"
            }
          />
        </div>
        <div class="practical-details">
          {[5, 7, 9, 11].map((index, i) => (
            <details class="detail-row" open={i === 0}>
              <summary>
                {plain(c.pricing[index])}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div class:list={["prose", { "appointment-contacts": index === 7 }]} set:html={c.pricing[index + 1]} />
            </details>
          ))}
        </div>
      </section>
    </>
  )}
  {page === "location" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.locationTitle}
          <br />
          <em>{t.locationEm}</em>
        </h1>
      </section>
      <div class="wide-photo container"><Image src={winterImage} widths={[640, 1280, 1600]} quality={90} alt={lang === "fr" ? "Les montagnes de Verbier en hiver" : "Verbier mountains in winter"} loading="eager" sizes="100vw" /></div>
      <FindUs lang={lang} full />
      <section class="section container location-info">
        <div>
          <h2>{t.appointments}</h2>
          <p class="lead">{t.appointmentHours}</p>
          <a class="text-link" href={href(lang, "contact")}>
            {t.book}
          </a>
        </div>
        <div>
          <h2>{t.reception}</h2>
          <p>
            {t.phoneHours}
            <br />
            {t.phoneHours2}
          </p>
          <p>{t.daily}</p>
          <a class="large-phone icon-link" href="tel:+41275650660"><ContactIcon name="phone" />+41 (0)27 565 06 60</a>
          <a class="large-phone icon-link" href={whatsapp} target="_blank" rel="noopener noreferrer"><WhatsAppIcon /><span>+41 (0)76 236 09 88</span></a>
          <div class="location-email">
            <h2>{t.write}</h2>
            <a class="large-phone icon-link" href="mailto:info@physio-verbier.com"><ContactIcon name="mail" /><span>info@physio-verbier.com</span></a>
          </div>
        </div>
      </section>
      <div class="container clinic-photos">
        <Image
          src={clinicImage}
          widths={[480, 960]}
          quality={90}
          sizes="(min-width: 640px) 480px, 90vw"
          loading="lazy"
          alt={
            lang === "fr"
              ? "La vitrine PhysioVerbier"
              : "The PhysioVerbier clinic window"
          }
        />
      </div>
    </>
  )}
  {page === "contact" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.contactTitle}
          <br />
          <em>{t.contactEm}</em>
        </h1>
      </section>
      <section class="container contact-grid">
        <div class="contact-methods">
          <div class="contact-block">
            <h2>{t.reception}</h2>
            <p>{t.phoneHours}<br />{t.phoneHours2}</p>
            <a class="large-phone icon-link" href="tel:+41275650660"><ContactIcon name="phone" /><span>+41 (0)27 565 06 60</span></a>
          </div>
          <div class="contact-block">
            <h2>{t.write}</h2>
            <p>{t.daily}</p>
            <a class="large-phone icon-link" href="mailto:info@physio-verbier.com"><ContactIcon name="mail" /><span>info@physio-verbier.com</span></a>
            <a class="large-phone icon-link" href={whatsapp} target="_blank" rel="noopener noreferrer"><WhatsAppIcon /><span>+41 (0)76 236 09 88</span></a>
          </div>
        </div>
        <Booking lang={lang} />
      </section>
    </>
  )}
  {page === "privacy" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.legal}
          <br />
          <em>& {t.privacy.toLowerCase()}.</em>
        </h1>
      </section>
      <article class="container legal-content prose">
        {lang === "fr" ? (
          <>
            <h2>{preview ? "Cette version de présentation" : "Le site PhysioVerbier"}</h2>
            <p>
              {preview ? "Cette version de présentation de PhysioVerbier est hébergée sur GitHub Pages." : "Ce site présente le cabinet PhysioVerbier, son équipe et ses prestations. Il est hébergé par Infomaniak Network SA, en Suisse."} Il ne constitue pas un portail patient. Le préparateur de rendez-vous ouvre WhatsApp ; vous choisissez ensuite d’envoyer le message au cabinet.
            </p>
            <h2>Le cabinet</h2>
            <p>
              PhysioVerbier
              <br />
              Route de Verbier Station 74
              <br />
              1936 Verbier, Suisse
              <br />
              <a href="mailto:info@physio-verbier.com">
                info@physio-verbier.com
              </a>
              <br />
              <a href="tel:+41275650660">+41 (0)27 565 06 60</a>
            </p>
            <h2>Préparer un rendez-vous</h2><p>Vos choix et votre prénom servent à préparer un message dans votre navigateur, sans enregistrement sur le site. Au clic sur « Continuer sur WhatsApp », ces informations sont transmises à WhatsApp dans le lien prérempli. Vous pouvez modifier le message avant de l’envoyer au cabinet. Le rendez-vous est confirmé ensuite par le cabinet. Ne renseignez pas de données médicales.</p>
            <h2>Hébergement et navigation</h2>
            <p>
              {preview ? "Cette prévisualisation utilise GitHub Pages." : "Ce site est hébergé par Infomaniak."} Le chargement des pages communique des informations techniques à l’hébergeur, notamment votre adresse IP. Consultez sa{" "}
              <a
                href={preview ? "https://docs.github.com/fr/site-policy/privacy-policies/github-general-privacy-statement" : "https://www.infomaniak.com/fr/cgv/politique-de-confidentialite"}
                target="_blank"
                rel="noopener noreferrer"
              >
                déclaration de confidentialité
              </a>
              .
            </p>
            <p>
              Nous n’intégrons ici aucun outil de mesure d’audience, pixel
              publicitaire ou cookie applicatif. Les polices et les images sont
              servies avec le site.
            </p>
            <h2>Liens vers d’autres services</h2>
            <p>
              Apple Plans, Google Maps, Waze, WhatsApp, Instagram et Facebook ne sont chargés que
              si vous ouvrez leurs liens. Leurs propres règles de
              confidentialité s’appliquent alors. Évitez de transmettre des
              renseignements médicaux par les canaux de contact généraux.
            </p>
            <h2>Questions concernant vos données</h2>
            <p>Pour toute question sur vos données ou sur les informations transmises au cabinet, contactez PhysioVerbier à <a href="mailto:info@physio-verbier.com">info@physio-verbier.com</a>.</p>
            <h2>Images et contenus</h2>
            <p>
              Les textes et photographies proviennent du site actuel de
              PhysioVerbier et des fichiers remis pour la refonte. Les panoramas portent le crédit Verbier 4Vallées. Les crédits photographiques d’origine sont
              conservés dans les sources du projet, notamment Claudia Lamothe.
              Design et développement de cette version : Ruoss! Communication.
            </p>
          </>
        ) : (
          <>
            <h2>{preview ? "About this preview" : "About this website"}</h2>
            <p>
              {preview ? "This preview of PhysioVerbier is hosted on GitHub Pages." : "This website presents the PhysioVerbier clinic, its team and services. It is hosted by Infomaniak Network SA in Switzerland."} It is not a patient portal. The appointment helper opens WhatsApp; you then choose whether to send the message to the clinic.
            </p>
            <h2>The clinic</h2>
            <p>
              PhysioVerbier
              <br />
              Route de Verbier Station 74
              <br />
              1936 Verbier, Switzerland
              <br />
              <a href="mailto:info@physio-verbier.com">
                info@physio-verbier.com
              </a>
              <br />
              <a href="tel:+41275650660">+41 (0)27 565 06 60</a>
            </p>
            <h2>Appointment requests</h2><p>Your choices and first name prepare a message in your browser without being stored by this website. Clicking “Continue on WhatsApp” passes this information to WhatsApp in a prefilled link. You can edit the message before sending it to the clinic. The clinic confirms your appointment separately. Do not enter medical information.</p>
            <h2>Hosting and browsing</h2>
            <p>
              {preview ? "This preview uses GitHub Pages." : "This website is hosted by Infomaniak."} Loading the site communicates technical information, including your IP address, to the hosting provider. See its{" "}
              <a
                href={preview ? "https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" : "https://www.infomaniak.com/en/legal/confidentiality-policy"}
                target="_blank"
                rel="noopener noreferrer"
              >
                privacy statement
              </a>
              .
            </p>
            <p>
              This version has no analytics tools, advertising pixels or
              application cookies. Fonts and images are served with the website.
            </p>
            <h2>External services</h2>
            <p>
              Apple Maps, Google Maps, Waze, WhatsApp, Instagram and Facebook are only opened when
              you follow their links. Their own privacy policies then apply.
              Please avoid sharing medical information through general contact
              channels.
            </p>
            <h2>Questions about your data</h2>
            <p>For questions about your data or information sent to the clinic, contact PhysioVerbier at <a href="mailto:info@physio-verbier.com">info@physio-verbier.com</a>.</p>
            <h2>Images and content</h2>
            <p>
              Text and photography are taken from the existing PhysioVerbier
              website and files provided for the redesign. The panoramic photographs are credited to Verbier 4Vallées. Original photographic credits, including Claudia Lamothe,
              are retained in the project sources. This version is designed and
              developed by Ruoss! Communication.
            </p>
          </>
        )}
      </article>
    </>
  )}
</Layout>
