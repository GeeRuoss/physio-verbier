---
import FindUs from "../components/FindUs.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import Photo from "../components/Photo.astro";
import TeamCards from "../components/TeamCards.astro";
import content from "../data/content.json";
import {
  routes,
  href,
  ui,
  maps,
  whatsapp,
  type Lang,
  type Page,
} from "../data/site";
export function getStaticPaths() {
  return (["fr", "en"] as Lang[]).flatMap((lang) =>
    Object.entries(routes[lang]).map(([page, path]) => ({
      params: { route: path.replace(/\/$/, "") || undefined },
      props: { lang, page },
    })),
  );
}
const { lang, page } = Astro.props as { lang: Lang; page: Page };
const t = ui[lang],
  c = content[lang];
const titles = lang === "fr" ? {
  home: "Physiothérapie à Verbier · Massages et sport",
  team: "Notre équipe de physiothérapeutes à Verbier",
  services: "Physiothérapie, massages et coaching à Verbier",
  pricing: "Tarifs de physiothérapie et massages à Verbier",
  location: "Cabinet de physiothérapie à Verbier · Accès",
  contact: "Rendez-vous de physiothérapie à Verbier",
  privacy: "Mentions légales et confidentialité",
} : {
  home: "Physiotherapy in Verbier · Massage and sport",
  team: "Our physiotherapy team in Verbier",
  services: "Physiotherapy, massage and coaching in Verbier",
  pricing: "Physiotherapy and massage prices in Verbier",
  location: "Physiotherapy clinic in Verbier · Directions",
  contact: "Book physiotherapy in Verbier",
  privacy: "Legal notice and privacy",
};
const descriptions = lang === "fr" ? {
  home: "Physiothérapie, massages et coaching sportif à Verbier. Soins personnalisés au cabinet, Route de Verbier Station 74. Découvrez l’équipe et prenez rendez-vous.",
  team: "Rencontrez Piero, Hannah et Sybille, l’équipe de PhysioVerbier. Découvrez leurs parcours et leur approche des soins au cabinet de Verbier.",
  services: "Découvrez les soins de PhysioVerbier : physiothérapie, massages et coaching sportif. Un accompagnement adapté à vos besoins au cœur de Verbier.",
  pricing: "Consultez les tarifs de physiothérapie, massages et coaching sportif chez PhysioVerbier et les informations utiles pour préparer votre première visite.",
  location: "Retrouvez PhysioVerbier à la Route de Verbier Station 74, 1936 Verbier. Adresse, itinéraire et horaires du cabinet de physiothérapie.",
  contact: "Prenez rendez-vous chez PhysioVerbier par téléphone, email ou WhatsApp. Retrouvez les coordonnées et horaires de contact du cabinet à Verbier.",
  privacy: "Informations légales, confidentialité et traitement des données sur le site PhysioVerbier.",
} : {
  home: "Physiotherapy, massage and personal training in Verbier. Personalised care at Route de Verbier Station 74. Meet the team and book an appointment.",
  team: "Meet Piero, Hannah and Sybille at PhysioVerbier. Discover their backgrounds and approach to personalised care at our Verbier clinic.",
  services: "Explore physiotherapy, massage and personal training at PhysioVerbier. Personalised care adapted to your needs in the heart of Verbier.",
  pricing: "See physiotherapy, massage and personal training prices at PhysioVerbier and find practical information for your first visit.",
  location: "Find PhysioVerbier at Route de Verbier Station 74, 1936 Verbier. Clinic address, directions and opening hours.",
  contact: "Book an appointment with PhysioVerbier by phone, email or WhatsApp. Find contact details and reception hours for our Verbier clinic.",
  privacy: "Legal information, privacy and data processing on the PhysioVerbier website.",
};
const description = descriptions[page];
const names = ["Piero", "Hannah", "Sybille"];
const ids = ["physiotherapie", "massages", "coaching"];
const plain = (s: string) =>
  s
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
---

<Layout
  lang={lang}
  page={page}
  title={`${titles[page]} | PhysioVerbier`}
  description={description}
>
  {page === "home" && (
    <>
      <section class="home-intro container">
        <div class="hero-heading">
          <h1>
            {t.hero}
            <br />
            <em>{t.heroEm}</em>
          </h1>
          <a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon /> {lang === "fr" ? "Rendez-vous sur WhatsApp" : "Book on WhatsApp"}
          </a>
        </div>
      </section>
      <div class="hero-photo-wrap">
        <Photo
          class="hero-photo"
          id={1}
          eager
          alt={
            lang === "fr"
              ? "Skieur aux Attelas, dans les montagnes de Verbier"
              : "Skier at Les Attelas in the mountains of Verbier"
          }
          sizes="100vw"
        />
      </div>
      <section id="bienvenue" class="section container welcome-section">
        <div class="care-grid">
          <Photo
            id={2}
            alt={
              lang === "fr"
                ? "Soin personnalisé chez PhysioVerbier"
                : "Personalised care at PhysioVerbier"
            }
          />
          <div class="care-copy">
            <h2>
              {t.careTitle}
              <br />
              <em>{t.careEm}</em>
            </h2>
            <p>
              {lang === "fr"
                ? "Notre cabinet de physiothérapie à Verbier vous propose des soins personnalisés, des massages et du coaching sportif. Pour retrouver votre bien-être et reprendre les activités que vous aimez."
                : "In the heart of Verbier, we offer personalised care tailored to your needs and goals. To help you feel better and get back to the activities you love."}
            </p>
            <a class="text-link" href={href(lang, "services")}>
              {t.discover}
              <Arrow diagonal />
            </a>
          </div>
        </div>
      </section>
      <section class="section services-preview">
        <div class="container">
          <h2>{lang === "fr" ? "Nos soins" : "Our services"}</h2>
          <div class="service-links">
            {t.serviceNames.map((name, i) => (
              <a
                class="service-link"
                href={`${href(lang, "services")}#${ids[i]}`}
              >
                <Photo id={[10, 13, 14][i]} alt="" sizes="200px" />
                <h3>{name}</h3>
                <span class="round-arrow">
                  <Arrow diagonal />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="section container">
        <div class="section-heading">
          <h2>{lang === "fr" ? "Notre équipe" : "Our team"}</h2>
          <a class="text-link" href={href(lang, "team")}>
            {t.meet}
            <Arrow diagonal />
          </a>
        </div>
        <TeamCards lang={lang} />
      </section>
    </>
  )}
  {page === "team" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.teamTitle}
          <br />
          <em>{t.teamEm}</em>
        </h1>
      </section>
      <div class="wide-photo container">
        <Photo
          id={15}
          eager
          alt={
            lang === "fr"
              ? "L’équipe devant le cabinet PhysioVerbier"
              : "The team outside the PhysioVerbier clinic"
          }
          sizes="100vw"
        />
      </div>
      <nav
        class="anchor-nav container"
        aria-label={lang === "fr" ? "Les thérapeutes" : "Our therapists"}
      >
        {names.map((name) => (
          <a href={`#${name.toLowerCase()}`}>
            {name}
            <Arrow class="arrow-down" />
          </a>
        ))}
      </nav>
      <div class="container team-profiles">
        {names.map((name, i) => (
          <section id={name.toLowerCase()} class="profile">
            <div class="profile-photo">
              <Photo id={16 + i} alt={name} />
            </div>
            <div class="profile-copy">
              <h2>{name}</h2>
              <div class="profile-role" set:html={c.team[2 + i * 3]} />
              <div class="prose biography" set:html={c.team[3 + i * 3]} />
              <a class="text-link" href={href(lang, "contact")}>
                {t.book}
                <Arrow diagonal />
              </a>
            </div>
          </section>
        ))}
      </div>
      <section class="container section original-approach">
        <details class="detail-row">
          <summary>
            {t.approach}
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="prose">
            {[2, 3, 4, 5, 6].map((i) => (
              <div set:html={c.home[i]} />
            ))}
          </div>
        </details>
      </section>
    </>
  )}
  {page === "services" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.servicesLead}
          <br />
          <em>{t.servicesLeadEm}</em>
        </h1>
        <div class="lead prose" set:html={c.services[1]} />
      </section>
      <nav class="anchor-nav container" aria-label={t.allServices}>
        {t.serviceNames.map((name, i) => (
          <a href={`#${ids[i]}`}>
            {name}
            <Arrow class="arrow-down" />
          </a>
        ))}
      </nav>
      <section class="container section treatment" id="physiotherapie">
        <div class="treatment-heading">
          <h2>{t.serviceNames[0]}</h2>
          <div class="prose" set:html={c.services[3]} />
        </div>
        <Photo
          class="treatment-photo"
          id={12}
          eager
          alt={
            lang === "fr"
              ? "Exercices de rééducation accompagnés par un physiothérapeute"
              : "Guided rehabilitation exercises with a physiotherapist"
          }
        />
        <div class="techniques">
          {[4, 5, 6, 7].map((index) => (
            <details class="detail-row">
              <summary>
                {(() => { const label = plain(c.services[index].split("</p>")[0]).toLocaleLowerCase(lang); return label.charAt(0).toLocaleUpperCase(lang) + label.slice(1); })()}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div
                class="prose"
                set:html={c.services[index].slice(
                  c.services[index].indexOf("</p>") + 4,
                )}
              />
            </details>
          ))}
          <div class="prose treatment-note" set:html={c.services[8]} />
        </div>
      </section>
      <section class="specialties-section section">
        <div class="container">
          <h2>{t.specializedEm}</h2>
          <div class="specialties-grid">
            {t.specialtyNames.map((name, i) => (
              <article>
                <h3>{name}</h3>
                <div class="prose" set:html={c.services[10 + i]} />
              </article>
            ))}
          </div>
        </div>
      </section>
      <section id="massages" class="container section service-feature">
        <Photo
          id={13}
          alt={
            lang === "fr"
              ? "Massage thérapeutique au cabinet"
              : "Therapeutic massage at the clinic"
          }
        />
        <div>
          <h2>{t.serviceNames[1]}</h2>
          <div class="prose" set:html={c.services[17]} />
          <a class="text-link" href={href(lang, "pricing")}>
            {t.nav[3]}
            <Arrow diagonal />
          </a>
        </div>
      </section>
      <section
        id="coaching"
        class="container section service-feature service-feature--reverse"
      >
        <Photo
          id={14}
          alt={
            lang === "fr"
              ? "Entraînement en plein air dans les Alpes"
              : "Outdoor training in the Alps"
          }
        />
        <div>
          <h2>{t.serviceNames[2]}</h2>
          <div class="prose" set:html={c.services[19]} />
          <a class="text-link" href={href(lang, "contact")}>
            {t.book}
            <Arrow diagonal />
          </a>
        </div>
      </section>
    </>
  )}
  {page === "pricing" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.pricingTitle}
          <br />
          <em>{t.pricingEm}</em>
        </h1>
      </section>
      <section class="container pricing-grid" aria-label={t.privateRates}>
        {t.serviceNames.map((name, i) => (
          <article class="price-card">
            <h2>{name}</h2>
            <p class="price-description">
              {i === 0 ? t.insurance : t.serviceDesc[i]}
            </p>
            <dl>
              {(i === 1
                ? [
                    [30, 75],
                    [60, 150],
                    [90, 225],
                  ]
                : i === 2
                  ? [
                      [30, 75],
                      [60, 140],
                    ]
                  : [
                      [30, 75],
                      [60, 150],
                    ]
              ).map(([minutes, price]) => (
                <div>
                  <dt>
                    {minutes} {t.minutes}
                  </dt>
                  <dd>
                    {price}
                    <span> CHF</span>
                  </dd>
                </div>
              ))}
            </dl>
            <a class="text-link" href={href(lang, "contact")}>
              {t.book}
              <Arrow diagonal />
            </a>
          </article>
        ))}
      </section>
      <div class="container insurance-note">
        <p>{t.hannahNote}</p>
      </div>
      <section class="section container practical-grid">
        <div>
          <h2>{t.practicalEm}</h2>
          <Photo
            id={22}
            alt={
              lang === "fr"
                ? "Salle de traitement du cabinet"
                : "Treatment room at the clinic"
            }
          />
        </div>
        <div class="practical-details">
          {[5, 7, 9, 11].map((index, i) => (
            <details class="detail-row" open={i === 0}>
              <summary>
                {plain(c.pricing[index])}
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <div class="prose" set:html={c.pricing[index + 1]} />
            </details>
          ))}
        </div>
      </section>
    </>
  )}
  {page === "location" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.locationTitle}
          <br />
          <em>{t.locationEm}</em>
        </h1>
      </section>
      <FindUs lang={lang} full />
      <section class="section container location-info">
        <div>
          <h2>{t.appointments}</h2>
          <p class="lead">{t.appointmentHours}</p>
          <a class="text-link" href={href(lang, "contact")}>
            {t.book}
            <Arrow diagonal />
          </a>
        </div>
        <div>
          <h2>{t.reception}</h2>
          <p>
            {t.phoneHours}
            <br />
            {t.phoneHours2}
          </p>
          <p>{t.daily}</p>
          <a class="large-phone" href="tel:+41275650660">
            +41 27 565 06 60
          </a>
        </div>
      </section>
      <div class="container clinic-photos">
        <Photo
          id={3}
          alt={
            lang === "fr"
              ? "L’espace de rééducation du cabinet"
              : "The clinic’s rehabilitation space"
          }
        />
        <Photo
          id={7}
          alt={
            lang === "fr"
              ? "La vitrine PhysioVerbier"
              : "The PhysioVerbier clinic window"
          }
        />
      </div>
    </>
  )}
  {page === "contact" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.contactTitle}
          <br />
          <em>{t.contactEm}</em>
        </h1>
      </section>
      <section class="container contact-grid">
        <div class="contact-methods">
          <a class="contact-method" href="tel:+41275650660">
            <span class="contact-label">{t.call}</span>
            <span>+41 27 565 06 60</span>
            <Arrow diagonal />
          </a>
          <a
            class="contact-method"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-label">{t.message}</span>
            <span>+41 76 236 09 88</span>
            <Arrow diagonal />
          </a>
          <a class="contact-method" href="mailto:info@physio-verbier.com">
            <span class="contact-label">{t.write}</span>
            <span>info@physio-verbier.com</span>
            <Arrow diagonal />
          </a>
          <div class="contact-hours">
            <h2>{t.reception}</h2>
            <p>
              {t.phoneHours}
              <br />
              {t.phoneHours2}
            </p>
            <p>{t.daily}</p>
            <a class="text-link" href={href(lang, "location")}>
              {t.nav[4]}
              <Arrow diagonal />
            </a>
          </div>
        </div>
        <div class="form-panel">
          <h2>{t.formTitle}</h2>
          <p>{t.formIntro}</p>
          <div class="demo-notice" id="demo-notice">
            {t.demo}
          </div>
          <form
            data-demo-form
            method="dialog"
            aria-describedby="demo-notice medical-notice"
          >
            <label for="contact-name">{t.name}</label>
            <input
              id="contact-name"
              type="text"
              autocomplete="off"
              maxlength="100"
              required
            />
            <label for="contact-phone">{t.phone}</label>
            <input
              id="contact-phone"
              type="tel"
              autocomplete="off"
              inputmode="tel"
              maxlength="30"
              minlength="6"
              required
            />
            <label for="contact-email">{t.email}</label>
            <input
              id="contact-email"
              type="email"
              autocomplete="off"
              maxlength="200"
            />
            <p id="medical-notice" class="form-fineprint">
              {t.noMedical}
            </p>
            <button class="button" type="submit">
              {t.submit}
              <Arrow />
            </button>
            <p
              id="form-status"
              class="form-status"
              role="status"
              tabindex="-1"
              hidden
            >
              {t.demoSuccess}
            </p>
            <noscript>
              <p>{t.demo}</p>
            </noscript>
          </form>
          <a class="privacy-link" href={href(lang, "privacy")}>
            {t.privacy}
            <Arrow diagonal />
          </a>
        </div>
      </section>
    </>
  )}
  {page === "privacy" && (
    <>
      <section class="page-intro container">
        <h1>
          {t.legal}
          <br />
          <em>& {t.privacy.toLowerCase()}.</em>
        </h1>
      </section>
      <article class="container legal-content prose">
        {lang === "fr" ? (
          <>
            <h2>Cette version de présentation</h2>
            <p>
              Ce site est une première version destinée à présenter le futur
              site de PhysioVerbier. Il est provisoirement hébergé sur GitHub
              Pages. Il ne constitue pas un portail patient et ne permet pas de
              transmettre de demande par formulaire.
            </p>
            <h2>Le cabinet</h2>
            <p>
              PhysioVerbier
              <br />
              Route de Verbier Station 74
              <br />
              1936 Verbier, Suisse
              <br />
              <a href="mailto:info@physio-verbier.com">
                info@physio-verbier.com
              </a>
              <br />
              <a href="tel:+41275650660">+41 27 565 06 60</a>
            </p>
            <h2>Formulaire de démonstration</h2>
            <p>
              Les champs servent uniquement à tester la présentation. Le site
              n’envoie pas leur contenu à un serveur et ne l’enregistre ni dans
              une base de données ni dans le stockage du navigateur. Utilisez
              des informations fictives pour vos essais. Pour une demande
              réelle, appelez le cabinet.
            </p>
            <h2>Hébergement et navigation</h2>
            <p>
              Cette prévisualisation utilise GitHub Pages, et non l’hébergement
              définitif Infomaniak. Le chargement du site communique
              nécessairement des informations techniques à l’hébergeur,
              notamment l’adresse IP. GitHub décrit son traitement dans sa{" "}
              <a
                href="https://docs.github.com/fr/site-policy/privacy-policies/github-general-privacy-statement"
                target="_blank"
                rel="noopener noreferrer"
              >
                déclaration de confidentialité
              </a>
              .
            </p>
            <p>
              Nous n’intégrons ici aucun outil de mesure d’audience, pixel
              publicitaire ou cookie applicatif. Un indicateur temporaire dans sessionStorage évite de répéter l’invitation WhatsApp pendant votre session ; il ne contient aucune donnée du formulaire. Les polices et les images sont
              servies avec le site.
            </p>
            <h2>Liens vers d’autres services</h2>
            <p>
              Apple Plans, Google Maps, Waze, WhatsApp, Instagram et Facebook ne sont chargés que
              si vous ouvrez leurs liens. Leurs propres règles de
              confidentialité s’appliquent alors. Évitez de transmettre des
              renseignements médicaux par les canaux de contact généraux.
            </p>
            <h2>Avant la mise en service définitive</h2>
            <p>
              Les modalités du formulaire définitif, les prestataires, les accès
              et les durées de conservation seront définis avec le cabinet et
              cette page sera actualisée avant son activation.
            </p>
            <h2>Images et contenus</h2>
            <p>
              Les textes et photographies proviennent du site actuel de
              PhysioVerbier, à l’exception de la photo de ski aux Attelas en accueil : © Verbier 4Vallées. Les crédits photographiques d’origine sont
              conservés dans les sources du projet, notamment Claudia Lamothe.
              Design et développement de cette version : Ruoss! Communication.
            </p>
          </>
        ) : (
          <>
            <h2>About this preview</h2>
            <p>
              This is a first version of the future PhysioVerbier website,
              temporarily hosted on GitHub Pages. It is not a patient portal and
              does not accept enquiries through the form.
            </p>
            <h2>The clinic</h2>
            <p>
              PhysioVerbier
              <br />
              Route de Verbier Station 74
              <br />
              1936 Verbier, Switzerland
              <br />
              <a href="mailto:info@physio-verbier.com">
                info@physio-verbier.com
              </a>
              <br />
              <a href="tel:+41275650660">+41 27 565 06 60</a>
            </p>
            <h2>Demo form</h2>
            <p>
              The fields are provided solely to test the layout. Their contents
              are not sent to a server or saved in a database or browser storage
              by this website. Please use fictitious details when testing. For a
              real enquiry, call the clinic.
            </p>
            <h2>Hosting and browsing</h2>
            <p>
              This preview uses GitHub Pages, not the final Infomaniak hosting.
              Loading the site necessarily communicates technical information,
              including your IP address, to the hosting provider. See the{" "}
              <a
                href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub privacy statement
              </a>
              .
            </p>
            <p>
              This version has no analytics tools, advertising pixels or
              application cookies. A temporary sessionStorage flag prevents the WhatsApp invitation from repeating during your session; it contains no form data. Fonts and images are served with the website.
            </p>
            <h2>External services</h2>
            <p>
              Apple Maps, Google Maps, Waze, WhatsApp, Instagram and Facebook are only opened when
              you follow their links. Their own privacy policies then apply.
              Please avoid sharing medical information through general contact
              channels.
            </p>
            <h2>Before the final launch</h2>
            <p>
              The final form’s processing, providers, access permissions and
              retention periods will be agreed with the clinic and this page
              updated before the form is enabled.
            </p>
            <h2>Images and content</h2>
            <p>
              Text and photography are taken from the existing PhysioVerbier
              website, except the homepage ski photograph at Les Attelas: © Verbier 4Vallées. Original photographic credits, including Claudia Lamothe,
              are retained in the project sources. This version is designed and
              developed by Ruoss! Communication.
            </p>
          </>
        )}
      </article>
    </>
  )}
</Layout>
