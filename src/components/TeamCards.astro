---
import TeamPortrait from './TeamPortrait.astro';
import { href } from '../data/site';
import { teamMembers } from '../data/team';
const { lang } = Astro.props;
---
<div class="team-grid">
  {teamMembers.map(member => (
    <a class="team-card" href={`${href(lang, 'team')}#${member.name.toLowerCase()}`}>
      <div class="team-card__photo"><TeamPortrait member={member} sizes="(min-width: 1100px) 28vw, (min-width: 768px) 40vw, 90vw" /></div>
      <div class="team-card__label"><h3>{member.name}</h3></div>
    </a>
  ))}
</div>
