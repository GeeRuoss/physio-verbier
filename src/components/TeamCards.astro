---
import Photo from "./Photo.astro";
import Arrow from "./Arrow.astro";
import { href, ui } from "../data/site";
const { lang } = Astro.props;
const t = ui[lang];
const names = ["Piero", "Hannah", "Sybille"];
---

<div class="team-grid">
  {names.map((name, i) => (
    <a class="team-card" href={`${href(lang, "team")}#${name.toLowerCase()}`}>
      <div class="team-card__photo">
        <Photo id={16 + i} alt={name} sizes="(min-width: 768px) 33vw, 90vw" />
        <span class="round-arrow">
          <Arrow diagonal />
        </span>
      </div>
      <div class="team-card__label">
        <h3>{name}</h3>
        <span>{lang === "fr" ? "Physiothérapeute" : "Physiotherapist"}</span>
      </div>
    </a>
  ))}
</div>
