---
import {asset,href,mapDirections,type Lang} from '../data/site';
const {lang,full=false}=Astro.props as {lang:Lang;full?:boolean};
const fr=lang==='fr';
const destination='46.096118,7.225448';
---
<section class:list={['find-us', 'container', { 'find-us--full': full }]} id="plan">
 <div class="find-us-copy">
  <h2>{fr?'Nous trouver':'Find us'}<br/><em>{fr?'à Verbier.':'in Verbier.'}</em></h2>
  <p>Route de Verbier Station 74<br/>1936 Verbier</p>
  <p>{fr?'Centre médical MédiVerbier':'MédiVerbier Medical Centre'}</p>
  <div class="map-apps">
   <a href={mapDirections} target="_blank" rel="noopener noreferrer">Google Maps</a>
   <a href={`https://maps.apple.com/?daddr=${destination}&dirflg=d`} target="_blank" rel="noopener noreferrer">Apple {fr?'Plans':'Maps'}</a>
   <a href={`https://www.waze.com/ul?ll=${destination}&navigate=yes`} target="_blank" rel="noopener noreferrer">Waze</a>
  </div>
  {full ? <button class="text-link share-location" type="button" data-url={href(lang,'location')} data-copied={fr?'Lien copié':'Link copied'}>{fr?'Copier le lien pour venir':'Copy directions link'}</button> : <a class="text-link" href={href(lang,'location')}>{fr?'Voir les informations d’accès':'See directions'}</a>}
  <span class="share-status" role="status"></span>
 </div>
 <div class="map-art">
  <a href={mapDirections} target="_blank" rel="noopener noreferrer" aria-label={fr?'Itinéraire vers PhysioVerbier sur Google Maps':'Directions to PhysioVerbier on Google Maps'}><img src={asset('images/clinic-map.svg')} width="900" height="900" loading="lazy" alt={fr?'Plan du quartier et emplacement de PhysioVerbier':'Neighbourhood map showing PhysioVerbier'}/></a>
  <a class="map-credit" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
 </div>
</section>
